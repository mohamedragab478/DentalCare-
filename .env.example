# Vercel & Supabase Environment Variables Example
# Replace with your actual project credentials in .env or Vercel Environment Variables

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional App Host URL
APP_URL="MY_APP_URL"
